import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import java.lang.reflect.*;
import java.util.*;

@Service
@RequiredArgsConstructor
public class Shield {
    private final MaskingRegistry registry;

    public <T> T mask(T original) {
        return maskRecursive(original, new IdentityHashMap<>());
    }

    @SuppressWarnings("unchecked")
    private <T> T maskRecursive(T source, Map<Object, Object> visited) {
        if (source == null) return null;
        if (visited.containsKey(source)) return (T) visited.get(source);

        Class<?> clazz = source.getClass();
        if (!registry.isSensitive(clazz)) return source; // Fast Path

        try {
            T result = clazz.isRecord() ? maskRecord(source, visited) : maskPojo(source, visited);
            visited.put(source, result);
            return result;
        } catch (Exception e) {
            throw new RuntimeException("Shield failed to mask object of type: " + clazz.getName(), e);
        }
    }

    private <T> T maskRecord(T source, Map<Object, Object> visited) throws Exception {
        Class<?> clazz = source.getClass();
        RecordComponent[] components = clazz.getRecordComponents();
        Object[] args = new Object[components.length];
        Class<?>[] argTypes = new Class<?>[components.length];

        for (int i = 0; i < components.length; i++) {
            String name = components[i].getName();
            Object val = components[i].getAccessor().invoke(source);
            argTypes[i] = components[i].getType();
            args[i] = processField(clazz, name, val, visited);
        }
        return (T) clazz.getDeclaredConstructor(argTypes).newInstance(args);
    }

    private <T> T maskPojo(T source, Map<Object, Object> visited) throws Exception {
        Class<?> clazz = source.getClass();
        T copy = (T) clazz.getDeclaredConstructor().newInstance();
        for (Field field : clazz.getDeclaredFields()) {
            if (Modifier.isStatic(field.getModifiers())) continue;
            field.setAccessible(true);
            Object val = field.get(source);
            field.set(copy, processField(clazz, field.getName(), val, visited));
        }
        return copy;
    }

    private Object processField(Class<?> clazz, String fieldName, Object val, Map<Object, Object> visited) {
        return registry.getNodes(clazz).stream()
                .filter(node -> node.fieldName().equals(fieldName))
                .findFirst()
                .map(node -> node.isDeep() ? maskRecursive(val, visited) : node.maskPattern())
                .orElse(val);
    }
}
