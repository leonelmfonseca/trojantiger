import io.github.classgraph.*;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;

public class MaskingRegistry {
    private final String basePackage;
    private final Map<Class<?>, List<MaskingNode>> registry = new ConcurrentHashMap<>();
    private final Set<Class<?>> sensitiveClasses = Collections.newSetFromMap(new ConcurrentHashMap<>());

    public record MaskingNode(String fieldName, String maskPattern, boolean isDeep, Class<?> type) {}

    public MaskingRegistry(String basePackage) {
        this.basePackage = basePackage;
    }

    public void scan() {
        try (ScanResult scanResult = new ClassGraph()
                .enableAllInfo()
                .acceptPackages(basePackage)
                .scan()) {

            scanResult.getAllClasses().forEach(classInfo -> {
                List<MaskingNode> nodes = buildPath(classInfo, new HashSet<>());
                if (!nodes.isEmpty()) {
                    Class<?> clazz = classInfo.loadClass();
                    registry.put(clazz, nodes);
                    sensitiveClasses.add(clazz);
                }
            });
        }
    }

    private List<MaskingNode> buildPath(ClassInfo classInfo, Set<String> visited) {
        if (classInfo == null || !visited.add(classInfo.getName())) return Collections.emptyList();

        List<MaskingNode> nodes = new ArrayList<>();
        
        // ClassGraph's getFieldInfo() picks up Record components too!
        for (FieldInfo field : classInfo.getFieldInfo()) {
            AnnotationInfo annot = field.getAnnotationInfo(Sensitive.class.getName());

            if (annot != null) {
                // Get the 'mask' value from the annotation
                String pattern = (String) annot.getParameterValues().getValue("mask");
                nodes.add(new MaskingNode(field.getName(), pattern, false, null));
            } else {
                // Check if we need to drill down (User-defined types in our package)
                TypeSignature typeSig = field.getTypeSignatureOrTypeDescriptor();
                if (typeSig instanceof ClassRefTypeSignature classRef) {
                    ClassInfo typeInfo = classRef.getClassInfo();
                    if (typeInfo != null && typeInfo.getName().startsWith(basePackage) && !typeInfo.isEnum()) {
                        // Recurse: If children have sensitive data, mark this field as "isDeep"
                        if (!buildPath(typeInfo, new HashSet<>(visited)).isEmpty()) {
                            nodes.add(new MaskingNode(field.getName(), null, true, typeInfo.loadClass()));
                        }
                    }
                }
            }
        }
        return nodes;
    }

    public boolean isSensitive(Class<?> clazz) { return sensitiveClasses.contains(clazz); }
    public List<MaskingNode> getNodes(Class<?> clazz) { return registry.getOrDefault(clazz, List.of()); }
}
