@AutoConfiguration
public class ShieldAutoConfiguration {

    @Bean
    @ConditionalOnMissingBean
    public MaskingRegistry maskingRegistry(@Value("${shield.base-package}") String basePkg) {
        MaskingRegistry registry = new MaskingRegistry(basePkg);
        registry.scan();
        return registry;
    }

    @Bean
    public Shield shield(MaskingRegistry registry) {
        return new Shield(registry);
    }

    // Jackson Integration: Auto-masking during JSON serialization
    @Bean
    public Module maskingModule(Shield shield) {
        SimpleModule module = new SimpleModule();
        module.setSerializerModifier(new BeanSerializerModifier() {
            @Override
            public List<BeanPropertyWriter> changeProperties(SerializationConfig config, 
                    BeanDescription beanDesc, List<BeanPropertyWriter> beanProperties) {
                for (BeanPropertyWriter writer : beanProperties) {
                    if (writer.getAnnotation(Sensitive.class) != null) {
                        writer.assignSerializer(new JsonSerializer<>() {
                            @Override
                            public void serialize(Object value, JsonGenerator gen, SerializerProvider serializers) throws IOException {
                                Sensitive s = writer.getAnnotation(Sensitive.class);
                                gen.writeString(s.mask());
                            }
                        });
                    }
                }
                return beanProperties;
            }
        });
        return module;
    }
}
