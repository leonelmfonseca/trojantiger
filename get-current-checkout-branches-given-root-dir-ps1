Set-Location "C:\path\to\root"; Get-ChildItem -Directory | ForEach-Object {
  $repo = $_.FullName
  $pom = Join-Path $repo "pom.xml"

  if (Test-Path $pom) {
    $found = $false

    Push-Location $repo
    try {
      $branches = git branch --format='%(refname:short)'
      foreach ($branch in $branches) {
        $result = git grep -n "<artifactId>pay-validation-lib</artifactId>" "$branch" -- pom.xml 2>$null
        if ($LASTEXITCODE -eq 0) {
          $found = $true
          Write-Output "$($_.Name): found in branch $branch"
          break
        }
      }

      if (-not $found) {
        Write-Output "$($_.Name): not found in any local branch"
      }
    } finally {
      Pop-Location
    }
  }
}
