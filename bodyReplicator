@Component
@Order(1)
@Slf4j
public class PerfectMdcFilter extends OncePerRequestFilter {
    
    private final ObjectMapper mapper = new ObjectMapper();
    
    @Override
    protected void doFilterInternal(HttpServletRequest request, 
                                  HttpServletResponse response, 
                                  FilterChain chain) throws ServletException, IOException {
        
        if (isJsonRequest(request)) {
            // 1. ONE-TIME READ (original stream consumed)
            byte[] bodyBytes = readBodyBytes(request);
            String bodyJson = new String(bodyBytes, StandardCharsets.UTF_8);
            
            // 2. Extract MDC (pre-doFilter)
            JsonNode root = mapper.readTree(bodyJson);
            String customerId = getValue(root, "customerId");
            MDC.put("customerId", customerId != null ? customerId : "unknown");
            
            log.debug("🔗 Pre-doFilter MDC: {}", MDC.get("customerId"));
            
            // 3. REPLAY FRESH COPY TO SPRING
            ByteArrayInputStream replayStream = new ByteArrayInputStream(bodyBytes.clone());
            HttpServletRequest replayWrapper = createReplayingWrapper(request, replayStream);
            
            try {
                chain.doFilter(replayWrapper, response);
            } finally {
                MDC.clear();
            }
        } else {
            chain.doFilter(request, response);
        }
    }
    
    private byte[] readBodyBytes(HttpServletRequest request) throws IOException {
        try (ServletInputStream sis = request.getInputStream();
             ByteArrayOutputStream baos = new ByteArrayOutputStream()) {
            
            byte[] buffer = new byte[8192];
            int bytesRead;
            while ((bytesRead = sis.read(buffer)) != -1) {
                baos.write(buffer, 0, bytesRead);
            }
            return baos.toByteArray();
        }
    }
    
    private HttpServletRequest createReplayingWrapper(HttpServletRequest original, 
                                                   ByteArrayInputStream replayStream) {
        return new HttpServletRequestWrapper(original) {
            @Override
            public ServletInputStream getInputStream() throws IOException {
                return new ReplayingServletInputStream(replayStream);
            }
        };
    }
}
