package com.azqore.payments.masking.core;

import ch.qos.logback.classic.Level;
import ch.qos.logback.classic.Logger;
import ch.qos.logback.classic.LoggerContext;
import ch.qos.logback.core.read.ListAppender;
import com.azqore.payments.masking.annotation.Sensitive;
import com.azqore.payments.masking.logback.SensitiveTurboFilter;
import com.azqore.payments.masking.masking.FullMaskingStrategy;
import com.azqore.payments.masking.masking.SensitiveMasker;
import com.azqore.payments.masking.meta.MetadataRegistry;
import com.azqore.payments.masking.meta.MetadataScanner;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.slf4j.LoggerFactory;

import java.util.List;
import java.util.Map;
import java.util.Optional;

import static org.assertj.core.api.Assertions.assertThat;

public class SensitiveMaskerFullMaskingDemoTest {

    private static final LoggerContext CONTEXT = (LoggerContext) LoggerFactory.getILoggerFactory();

    // Do NOT create the logger as a field initialized at class load time.
    // Create it in setup AFTER the TurboFilter is registered.
    private Logger testLogger;

    private ListAppender<ch.qos.logback.classic.spi.ILoggingEvent> listAppender;
    private SensitiveTurboFilter turboFilter;

    // Annotated record: mark sensitive components including a primitive component
    public record Card(
        @Sensitive(regex = "\\d(?=\\d{4})", mask = "*") String number,
        @Sensitive String cvv,
        @Sensitive int secretCode, // primitive marked sensitive
        int expiryYear
    ) {}

    // POJO with annotated sensitive fields (String and primitive)
    public static class User {
        public String name;
        @Sensitive
        public String ssn;
        @Sensitive
        public int pin; // primitive sensitive field
        public Card[] cards;
        public Map<String, Object> metadata;
        public Optional<String> note;

        public User(String name, String ssn, int pin, Card[] cards, Map<String,Object> metadata, Optional<String> note) {
            this.name = name;
            this.ssn = ssn;
            this.pin = pin;
            this.cards = cards;
            this.metadata = metadata;
            this.note = note;
        }
    }

    @BeforeEach
    void setup() {
        // 1) Prepare metadata registry and pre-scan the test package so record component annotations are discovered
        MetadataRegistry registry = new MetadataRegistry();
        MetadataScanner scanner = new MetadataScanner(registry);
        scanner.scan(this.getClass().getPackageName()); // pre-warm metadata for test classes

        // 2) Create masker and turbo filter (masking enabled for INFO)
        SensitiveMasker masker = new SensitiveMasker(new FullMaskingStrategy(), "****", "\\d(?=\\d{4})", registry);
        turboFilter = new SensitiveTurboFilter(masker, java.util.Set.of(Level.INFO));

        // 3) Register the filter with Logback BEFORE creating the logger or attaching appenders
        turboFilter.start();
        CONTEXT.addTurboFilter(turboFilter);

        // 4) Now create the logger and attach a ListAppender to capture formatted messages
        testLogger = (Logger) LoggerFactory.getLogger(SensitiveMaskerFullMaskingDemoTest.class);
        listAppender = new ListAppender<>();
        listAppender.start();
        testLogger.addAppender(listAppender);
        testLogger.setLevel(Level.INFO);
    }

    @AfterEach
    void tearDown() {
        if (testLogger != null && listAppender != null) {
            testLogger.detachAppender(listAppender);
            listAppender.stop();
        }
        if (turboFilter != null) {
            CONTEXT.getTurboFilterList().remove(turboFilter);
            turboFilter.stop();
        }
    }

    @Test
    void logsAreMasked_forRecordsArraysCollectionsMapsAndPrimitives() {
        // Create sample data containing sensitive-looking values
        Card card = new Card("4111111111111111", "123", 4242, 2026);
        User user = new User(
                "Alice",
                "123-45-6789",
                9999,
                new Card[]{card},
                Map.of("primaryCard", card, "notes", "VIP"),
                Optional.of("sensitive-note-42")
        );

        // Keep originals for later assertions (must remain unchanged)
        String originalNumber = card.number();
        String originalCvv = card.cvv();
        int originalSecretCode = card.secretCode();
        String originalSsn = user.ssn;
        int originalPin = user.pin;

        // Log parameterized message so TurboFilter can intercept params
        org.slf4j.Logger log = LoggerFactory.getLogger(SensitiveMaskerFullMaskingDemoTest.class);
        log.info("Processing user: {}", user);

        // Grab the formatted message from the ListAppender
        List<ch.qos.logback.classic.spi.ILoggingEvent> events = listAppender.list;
        assertThat(events).isNotEmpty();

        String formatted = events.get(0).getFormattedMessage();

        // 1) Raw sensitive values must not appear verbatim in the formatted log
        assertThat(formatted).doesNotContain(originalNumber);
        assertThat(formatted).doesNotContain(originalCvv);
        assertThat(formatted).doesNotContain(String.valueOf(originalSecretCode));
        assertThat(formatted).doesNotContain(originalSsn);
        assertThat(formatted).doesNotContain(String.valueOf(originalPin));
        assertThat(formatted).doesNotContain("sensitive-note-42");

        // 2) Masked tokens should appear (default mask "****" or mask char from annotation)
        assertThat(formatted).contains("****");      // default mask present somewhere
        assertThat(formatted).contains("1111");      // last 4 digits visible due to regex
        assertThat(formatted).contains("Alice");     // non-sensitive field still present

        // 3) Original objects must remain unchanged (non-mutating guarantee)
        assertThat(card.number()).isEqualTo(originalNumber);
        assertThat(card.cvv()).isEqualTo(originalCvv);
        assertThat(card.secretCode()).isEqualTo(originalSecretCode);
        assertThat(user.ssn).isEqualTo(originalSsn);
        assertThat(user.pin).isEqualTo(originalPin);
    }
}
