import ch.qos.logback.classic.LoggerContext;
import ch.qos.logback.classic.spi.ILoggingEvent;
import ch.qos.logback.core.AppenderBase;

@SpringBootTest
class LoggingMaskingTest {

    private MemoryAppender memoryAppender;
    private Logger testLogger;

    @BeforeEach
    void setUp() {
        testLogger = (Logger) LoggerFactory.getLogger(LoggingMaskingTest.class);
        memoryAppender = new MemoryAppender();
        memoryAppender.setContext((LoggerContext) LoggerFactory.getILoggerFactory());
        memoryAppender.start();
        testLogger.addAppender(memoryAppender);
        testLogger.setLevel(Level.INFO);
    }

    @AfterEach
    void tearDown() {
        if (testLogger != null && memoryAppender != null) {
            testLogger.detachAppender(memoryAppender);
            memoryAppender.stop();
        }
    }

    @Test
    void loggedGarageMasksAddress() {
        Garage garage = new Garage("123 Main St", 50, List.of());

        testLogger.info("garage: {}", garage);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage).contains("address=1*********t");
    }

    @Test
    void loggedGarageMasksCapacity() {
        Garage garage = new Garage("X", 50, List.of());

        testLogger.info("garage: {}", garage);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage).contains("capacity=****");
    }

    @Test
    void loggedGarageReplacesCarsWithCustomValue() {
        Garage garage = new Garage("X", 0, List.of(new Car("Red", BigDecimal.valueOf(100))));

        testLogger.info("garage: {}", garage);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage).contains("cars=***CARS***");
    }

    @Test
    void loggedCarMasksPrice() {
        Car car = new Car("Red", BigDecimal.valueOf(100));

        testLogger.info("car: {}", car);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage)
            .contains("color=Red")
            .contains("price=****")
            .doesNotContain("price=100");
    }

    @Test
    void loggedDealershipMasksNameAndNestedCarPrices() {
        Dealership d = new Dealership("Acme Auto",
            List.of(new Car("Red", BigDecimal.valueOf(100)), new Car("Blue", BigDecimal.valueOf(200))));

        testLogger.info("Dealership: {}", d);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage)
            .contains("name=****")
            .contains("price=****")
            .contains("color=Red")
            .doesNotContain("price=100")
            .doesNotContain("price=200");
    }

    @Test
    void multipleLogArgumentsAllMasked() {
        Garage g1 = new Garage("First Ave", 10, List.of());
        Garage g2 = new Garage("Second St", 20, List.of());

        testLogger.info("two garages: {} and {}", g1, g2);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage)
            .contains("address=F*******e")
            .contains("address=S*******t");
    }

    @Test
    void logMessageWithoutMaskedArgsPassesThrough() {
        testLogger.info("plain message, no objects");

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage).isEqualTo("plain message, no objects");
    }

    @Test
    void loggedDeepNestingMasksInnermostSecret() {
        DeepSecret deep = new DeepSecret("my-secret");
        MiddleLayer mid = new MiddleLayer(deep, "visible-text");
        TopContainer top = new TopContainer(mid, "top-name");

        testLogger.info("top: {}", top);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage)
            .contains("secret=****")
            .contains("visible=visible-text")
            .doesNotContain("my-secret");
    }

    @Test
    void loggedCycleDoesNotStackOverflow() {
        TreeNode child = new TreeNode("child", List.of());
        TreeNode parent = new TreeNode("parent", List.of(child));

        testLogger.info("tree: {}", parent);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage)
            .contains("label=****")
            .doesNotContain("label=child");
    }

    @Test
    void loggedSetFieldIsReplaced() {
        DataStructures ds = new DataStructures(
            Set.of("a", "b"), null, null, null, null, null, null, null);

        testLogger.info("ds: {}", ds);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage).contains("maskedSet=***SET***");
    }

    @Test
    void loggedMapFieldIsReplaced() {
        DataStructures ds = new DataStructures(
            null, Map.of("k1", 1), null, null, null, null, null, null);

        testLogger.info("ds: {}", ds);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage).contains("maskedMap=***MAP***");
    }

    @Test
    void loggedPrimitiveArrayIsReplaced() {
        DataStructures ds = new DataStructures(
            null, null, new int[]{10, 20}, null, null, null, null, null);

        testLogger.info("ds: {}", ds);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage).contains("maskedIntArray=***INT_ARR***");
    }

    @Test
    void loggedObjectArrayIsReplaced() {
        Car[] cars = new Car[]{new Car("Red", BigDecimal.valueOf(100))};
        DataStructures ds = new DataStructures(
            null, null, null, cars, null, null, null, null);

        testLogger.info("ds: {}", ds);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage).contains("maskedCarArray=***CAR_ARR***");
    }

    @Test
    void loggedQueueIsReplaced() {
        Queue<String> q = new LinkedList<>();
        q.add("x");
        DataStructures ds = new DataStructures(
            null, null, null, null, q, null, null, null);

        testLogger.info("ds: {}", ds);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage).contains("maskedQueue=***QUEUE***");
    }

    @Test
    void loggedDequeIsReplaced() {
        Deque<String> dq = new ArrayDeque<>();
        dq.add("y");
        DataStructures ds = new DataStructures(
            null, null, null, null, null, dq, null, null);

        testLogger.info("ds: {}", ds);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage).contains("maskedDeque=***DEQUE***");
    }

    @Test
    void loggedUnannotatedListOfMaskedRecordsMasksTransitively() {
        List<DeepSecret> secrets = List.of(new DeepSecret("alpha"), new DeepSecret("omega"));
        DataStructures ds = new DataStructures(
            null, null, null, null, null, null, null, secrets);

        testLogger.info("ds: {}", ds);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage)
            .contains("secret=****")
            .doesNotContain("alpha");
    }

    @Test
    void loggedSelfReferringListDoesNotLoop() {
        TreeNode root = new TreeNode("root", new LinkedList<>());
        root.getChildren().add(root);

        testLogger.info("tree: {}", root);

        String logMessage = memoryAppender.lastEvent().getFormattedMessage();
        assertThat(logMessage)
            .contains("label=****")
            .contains("(");
    }

    private static class MemoryAppender extends AppenderBase<ILoggingEvent> {
        private final List<ILoggingEvent> events = new java.util.concurrent.CopyOnWriteArrayList<>();

        @Override
        protected void append(ILoggingEvent event) {
            events.add(event);
        }

        ILoggingEvent lastEvent() {
            return events.get(events.size() - 1);
        }
    }
}


package com.leonelmfonseca.logmasker.masking;

import static org.assertj.core.api.Assertions.assertThat;

import java.math.BigDecimal;
import java.util.ArrayDeque;
import java.util.Deque;
import java.util.LinkedList;
import java.util.List;
import java.util.Map;
import java.util.Queue;
import java.util.Set;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;

import com.leonelmfonseca.logmasker.masking.testmodel.Car;
import com.leonelmfonseca.logmasker.masking.testmodel.DataStructures;
import com.leonelmfonseca.logmasker.masking.testmodel.Dealership;
import com.leonelmfonseca.logmasker.masking.testmodel.DeepSecret;
import com.leonelmfonseca.logmasker.masking.testmodel.Garage;
import com.leonelmfonseca.logmasker.masking.testmodel.MiddleLayer;
import com.leonelmfonseca.logmasker.masking.testmodel.TopContainer;
import com.leonelmfonseca.logmasker.masking.testmodel.TreeNode;

@SpringBootTest
class MaskingServiceTest {

    @Autowired
    private MaskingService maskingService;

    @Test
    void hasMaskedFieldsForDirectlyAnnotatedClass() {
        assertThat(maskingService.hasMaskedFields(Garage.class)).isTrue();
    }

    @Test
    void hasMaskedFieldsForNestedAnnotatedRecord() {
        assertThat(maskingService.hasMaskedFields(Car.class)).isTrue();
    }

    @Test
    void hasMaskedFieldsForPlainObjectIsFalse() {
        assertThat(maskingService.hasMaskedFields(String.class)).isFalse();
    }

    @Test
    void maskStringFieldWithPrefixAndSuffix() {
        Garage g = new Garage("123 Main St", 50, List.of());
        String result = String.valueOf(maskingService.mask(g));
        assertThat(result).contains("address=1*********t");
    }

    @Test
    void maskIntFieldWithDefaultReplacement() {
        Garage g = new Garage("X", 50, List.of());
        String result = String.valueOf(maskingService.mask(g));
        assertThat(result).contains("capacity=****");
    }

    @Test
    void maskListFieldWithCustomReplacement() {
        Garage g = new Garage("X", 0, List.of(new Car("Red", BigDecimal.valueOf(100))));
        String result = String.valueOf(maskingService.mask(g));
        assertThat(result).contains("cars=***CARS***");
    }

    @Test
    void nestedRecordPriceIsMaskedViaDeepTraversal() {
        List<Car> cars = List.of(
            new Car("Red", BigDecimal.valueOf(100)),
            new Car("Blue", BigDecimal.valueOf(200))
        );
        Dealership d = new Dealership("Acme", cars);
        String result = String.valueOf(maskingService.mask(d));

        assertThat(result)
            .contains("name=****")
            .contains("price=****")
            .doesNotContain("price=100")
            .doesNotContain("price=200")
            .contains("color=Red")
            .contains("color=Blue");
    }

    @Test
    void garageWithCustomCarReplacementHidesNestedDetails() {
        Garage g = new Garage("X", 0, List.of(new Car("Red", BigDecimal.valueOf(100))));
        String result = String.valueOf(maskingService.mask(g));

        assertThat(result)
            .contains("cars=***CARS***")
            .doesNotContain("price=100");
    }

    @Test
    void unmaskedFieldsAreVisible() {
        Car car = new Car("Red", BigDecimal.valueOf(100));
        String result = String.valueOf(maskingService.mask(car));

        assertThat(result)
            .contains("color=Red")
            .contains("price=****");
    }

    @Test
    void nullInputReturnsNull() {
        assertThat(maskingService.mask(null)).isNull();
    }

    @Test
    void collectionOfMaskedObjects() {
        List<Car> cars = List.of(
            new Car("Green", BigDecimal.valueOf(50)),
            new Car("Yellow", BigDecimal.valueOf(75))
        );
        Object result = maskingService.mask(cars);
        assertThat(result.toString())
            .contains("price=****")
            .doesNotContain("price=50")
            .doesNotContain("price=75");
    }

    @Test
    void mapWithMaskedValues() {
        Map<String, Car> map = Map.of(
            "primary", new Car("White", BigDecimal.valueOf(999))
        );
        Object result = maskingService.mask(map);
        assertThat(result.toString())
            .contains("price=****")
            .doesNotContain("price=999");
    }

    @Test
    void deepNestingMasksInnermostSecret() {
        DeepSecret deep = new DeepSecret("my-secret");
        MiddleLayer mid = new MiddleLayer(deep, "visible-text");
        TopContainer top = new TopContainer(mid, "top-name");
        String result = String.valueOf(maskingService.mask(top));

        assertThat(result)
            .contains("secret=****")
            .contains("visible=visible-text")
            .contains("name=top-name")
            .doesNotContain("my-secret");
    }

    @Test
    void cycleDetectionDoesNotStackOverflow() {
        TreeNode child = new TreeNode("child", List.of());
        TreeNode parent = new TreeNode("parent", List.of(child));
        String result = String.valueOf(maskingService.mask(parent));

        assertThat(result)
            .contains("label=****")
            .doesNotContain("label=child")
            .doesNotContain("label=parent");
    }

    @Test
    void maskedSetFieldIsReplaced() {
        DataStructures ds = new DataStructures(
            Set.of("a", "b"), null, null, null, null, null, null, null);
        String result = String.valueOf(maskingService.mask(ds));
        assertThat(result).contains("maskedSet=***SET***");
    }

    @Test
    void maskedMapFieldIsReplaced() {
        DataStructures ds = new DataStructures(
            null, Map.of("k1", 1, "k2", 2), null, null, null, null, null, null);
        String result = String.valueOf(maskingService.mask(ds));
        assertThat(result).contains("maskedMap=***MAP***");
    }

    @Test
    void maskedPrimitiveArrayIsReplaced() {
        DataStructures ds = new DataStructures(
            null, null, new int[]{10, 20, 30}, null, null, null, null, null);
        String result = String.valueOf(maskingService.mask(ds));
        assertThat(result).contains("maskedIntArray=***INT_ARR***");
    }

    @Test
    void maskedObjectArrayIsReplaced() {
        Car[] cars = new Car[]{new Car("Red", BigDecimal.valueOf(100))};
        DataStructures ds = new DataStructures(
            null, null, null, cars, null, null, null, null);
        String result = String.valueOf(maskingService.mask(ds));
        assertThat(result).contains("maskedCarArray=***CAR_ARR***");
    }

    @Test
    void maskedQueueIsReplaced() {
        Queue<String> q = new LinkedList<>();
        q.add("x");
        DataStructures ds = new DataStructures(
            null, null, null, null, q, null, null, null);
        String result = String.valueOf(maskingService.mask(ds));
        assertThat(result).contains("maskedQueue=***QUEUE***");
    }

    @Test
    void maskedDequeIsReplaced() {
        Deque<String> dq = new ArrayDeque<>();
        dq.add("y");
        DataStructures ds = new DataStructures(
            null, null, null, null, null, dq, null, null);
        String result = String.valueOf(maskingService.mask(ds));
        assertThat(result).contains("maskedDeque=***DEQUE***");
    }

    @Test
    void unannotatedListOfMaskedRecordsMasksElementsTransitively() {
        List<DeepSecret> secrets = List.of(
            new DeepSecret("alpha"), new DeepSecret("omega"));
        DataStructures ds = new DataStructures(
            null, null, null, null, null, null, null, secrets);
        String result = String.valueOf(maskingService.mask(ds));

        assertThat(result)
            .contains("secret=****")
            .doesNotContain("alpha")
            .doesNotContain("omega");
    }

    @Test
    void emptyCollectionFieldWithMaskIsStillReplaced() {
        DataStructures ds = new DataStructures(
            Set.of(), null, null, null, null, null, null, null);
        String result = String.valueOf(maskingService.mask(ds));
        assertThat(result).contains("maskedSet=***SET***");
    }

    @Test
    void treeNodeWithCycleInListDoesNotLoop() {
        TreeNode root = new TreeNode("root", new LinkedList<>());
        root.getChildren().add(root);
        String result = String.valueOf(maskingService.mask(root));

        assertThat(result)
            .contains("label=****")
            .contains("(");
    }

    @Test
    void hasMaskedFieldsForTransitiveClass() {
        assertThat(maskingService.hasMaskedFields(TopContainer.class)).isTrue();
        assertThat(maskingService.hasMaskedFields(MiddleLayer.class)).isTrue();
        assertThat(maskingService.hasMaskedFields(DataStructures.class)).isTrue();
    }
}


package com.leonelmfonseca.logmasker.masking.testmodel;

import java.math.BigDecimal;

import com.leonelmfonseca.logmasker.annotation.Mask;

public record Car(String color, @Mask BigDecimal price) {}

package com.leonelmfonseca.logmasker.masking.testmodel;

import java.util.Deque;
import java.util.List;
import java.util.Map;
import java.util.Queue;
import java.util.Set;

import com.leonelmfonseca.logmasker.annotation.Mask;

public class DataStructures {

    @Mask(value = "***SET***")
    private Set<String> maskedSet;

    @Mask(value = "***MAP***")
    private Map<String, Integer> maskedMap;

    @Mask(value = "***INT_ARR***")
    private int[] maskedIntArray;

    @Mask(value = "***CAR_ARR***")
    private Car[] maskedCarArray;

    @Mask(value = "***QUEUE***")
    private Queue<String> maskedQueue;

    @Mask(value = "***DEQUE***")
    private Deque<String> maskedDeque;

    private TreeNode cycleRoot;

    private List<DeepSecret> secrets;

    public DataStructures(
            Set<String> maskedSet,
            Map<String, Integer> maskedMap,
            int[] maskedIntArray,
            Car[] maskedCarArray,
            Queue<String> maskedQueue,
            Deque<String> maskedDeque,
            TreeNode cycleRoot,
            List<DeepSecret> secrets) {
        this.maskedSet = maskedSet;
        this.maskedMap = maskedMap;
        this.maskedIntArray = maskedIntArray;
        this.maskedCarArray = maskedCarArray;
        this.maskedQueue = maskedQueue;
        this.maskedDeque = maskedDeque;
        this.cycleRoot = cycleRoot;
        this.secrets = secrets;
    }

    public Set<String> getMaskedSet() { return maskedSet; }
    public Map<String, Integer> getMaskedMap() { return maskedMap; }
    public int[] getMaskedIntArray() { return maskedIntArray; }
    public Car[] getMaskedCarArray() { return maskedCarArray; }
    public Queue<String> getMaskedQueue() { return maskedQueue; }
    public Deque<String> getMaskedDeque() { return maskedDeque; }
    public TreeNode getCycleRoot() { return cycleRoot; }
    public List<DeepSecret> getSecrets() { return secrets; }
}
