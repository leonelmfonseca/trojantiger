public final class MaskedPojoView {

    private final Object original;
    private final List<String> fieldNames;
    private final List<String> maskedValues;

    public MaskedPojoView(Object original, List<String> fieldNames, List<String> maskedValues) {
        this.original = Objects.requireNonNull(original);
        this.fieldNames = List.copyOf(fieldNames);
        this.maskedValues = List.copyOf(maskedValues);
    }

    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder();
        sb.append(original.getClass().getSimpleName()).append("{");
        for (int i = 0; i < fieldNames.size(); i++) {
            if (i > 0) sb.append(", ");
            sb.append(fieldNames.get(i)).append("=").append(maskedValues.get(i));
        }
        sb.append("}");
        return sb.toString();
    }

    public Object original() { return original; }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof MaskedPojoView)) return false;
        MaskedPojoView that = (MaskedPojoView) o;
        return original.equals(that.original);
    }

    @Override
    public int hashCode() {
        return original.hashCode();
    }
}


