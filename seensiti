import ch.qos.logback.classic.spi.ILoggingEvent;
import ch.qos.logback.core.Appender;
import ch.qos.logback.core.UnsynchronizedAppenderBase;

public class MaskingAppender extends UnsynchronizedAppenderBase<ILoggingEvent> {

    private final MaskingService maskingService;
    private final Appender<ILoggingEvent> delegate;

    public MaskingAppender(MaskingService maskingService, Appender<ILoggingEvent> delegate) {
        this.maskingService = maskingService;
        this.delegate = delegate;
    }

    @Override
    protected void append(ILoggingEvent event) {
        Object[] argArray = event.getArgumentArray();
        if (argArray != null) {
            for (int i = 0; i < argArray.length; i++) {
                if (argArray[i] != null && maskingService.hasMaskedFields(argArray[i].getClass())) {
                    argArray[i] = new LazyMaskedWrapper(argArray[i], maskingService);
                }
            }
        }
        delegate.doAppend(event);
    }

    @Override
    public void stop() {
        if (delegate != null && delegate.isStarted()) {
            delegate.stop();
        }
        super.stop();
    }
}

