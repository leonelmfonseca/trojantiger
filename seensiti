package com.yourcompany.sensitive.meta;

import com.yourcompany.sensitive.annotation.Sensitive;

import java.lang.reflect.AccessibleObject;
import java.lang.reflect.Field;
import java.lang.reflect.RecordComponent;
import java.util.Optional;

public final class FieldMetadata {

    private final AccessibleObject accessor; // Field or Method (record accessor)
    private final boolean sensitive;
    private final String mask;
    private final String regex;

    private FieldMetadata(AccessibleObject accessor, boolean sensitive, String mask, String regex) {
        this.accessor = accessor;
        this.sensitive = sensitive;
        this.mask = mask;
        this.regex = regex;
    }

    public static FieldMetadata forField(Field field) {
        Sensitive s = field.getAnnotation(Sensitive.class);
        return new FieldMetadata(field,
                s != null,
                s != null ? s.mask() : "",
                s != null ? s.regex() : "");
    }

    public static FieldMetadata forRecordComponent(RecordComponent rc) {
        Sensitive s = rc.getAccessor().getAnnotation(Sensitive.class);
        return new FieldMetadata(rc.getAccessor(),
                s != null,
                s != null ? s.mask() : "",
                s != null ? s.regex() : "");
    }

    public AccessibleObject accessor() { return accessor; }
    public boolean isSensitive() { return sensitive; }
    public Optional<String> mask() { return mask == null || mask.isEmpty() ? Optional.empty() : Optional.of(mask); }
    public Optional<String> regex() { return regex == null || regex.isEmpty() ? Optional.empty() : Optional.of(regex); }
}


package com.yourcompany.sensitive.meta;

import java.lang.reflect.Constructor;
import java.lang.reflect.Field;
import java.lang.reflect.RecordComponent;
import java.util.List;

public final class ClassMetadata {

    private final Class<?> type;
    private final boolean record;
    private final Constructor<?> recordConstructor; // may be null
    private final List<RecordComponent> recordComponents;
    private final List<Field> fields;
    private final List<FieldMetadata> fieldMetadata;

    public ClassMetadata(Class<?> type,
                         boolean record,
                         Constructor<?> recordConstructor,
                         List<RecordComponent> recordComponents,
                         List<Field> fields,
                         List<FieldMetadata> fieldMetadata) {
        this.type = type;
        this.record = record;
        this.recordConstructor = recordConstructor;
        this.recordComponents = recordComponents;
        this.fields = fields;
        this.fieldMetadata = fieldMetadata;
    }

    public Class<?> type() { return type; }
    public boolean isRecord() { return record; }
    public Constructor<?> recordConstructor() { return recordConstructor; }
    public List<RecordComponent> recordComponents() { return recordComponents; }
    public List<Field> fields() { return fields; }
    public List<FieldMetadata> fieldMetadata() { return fieldMetadata; }
}


package com.yourcompany.sensitive.meta;

import java.lang.reflect.Constructor;
import java.lang.reflect.Field;
import java.lang.reflect.RecordComponent;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;

public class MetadataRegistry {

    private final Map<Class<?>, ClassMetadata> cache = new ConcurrentHashMap<>();

    public ClassMetadata getOrAnalyze(Class<?> type) {
        return cache.computeIfAbsent(type, this::analyzeClass);
    }

    private ClassMetadata analyzeClass(Class<?> type) {
        if (type.isRecord()) {
            RecordComponent[] components = type.getRecordComponents();
            List<RecordComponent> rcList = Arrays.asList(components);
            List<FieldMetadata> fm = new ArrayList<>(components.length);
            for (RecordComponent rc : components) {
                fm.add(FieldMetadata.forRecordComponent(rc));
            }
            Constructor<?> ctor = null;
            try {
                Class<?>[] paramTypes = Arrays.stream(components)
                        .map(RecordComponent::getType)
                        .toArray(Class[]::new);
                ctor = type.getDeclaredConstructor(paramTypes);
                ctor.setAccessible(true);
            } catch (Exception ignored) {}
            return new ClassMetadata(type, true, ctor, rcList, List.of(), fm);
        } else {
            List<Field> fields = getAllFields(type);
            List<FieldMetadata> fm = new ArrayList<>(fields.size());
            for (Field f : fields) {
                f.setAccessible(true);
                fm.add(FieldMetadata.forField(f));
            }
            return new ClassMetadata(type, false, null, List.of(), fields, fm);
        }
    }

    private List<Field> getAllFields(Class<?> type) {
        List<Field> fields = new ArrayList<>();
        Class<?> current = type;
        while (current != null && current != Object.class) {
            fields.addAll(Arrays.asList(current.getDeclaredFields()));
            current = current.getSuperclass();
        }
        return fields;
    }
}


package com.yourcompany.sensitive.meta;

import io.github.classgraph.ClassGraph;
import io.github.classgraph.ClassInfo;
import io.github.classgraph.ScanResult;

public class MetadataScanner {

    private final MetadataRegistry registry;

    public MetadataScanner(MetadataRegistry registry) {
        this.registry = registry;
    }

    public void scan(String... basePackages) {
        try (ScanResult scan = new ClassGraph()
                .enableClassInfo()
                .acceptPackages(basePackages)
                .scan()) {

            for (ClassInfo ci : scan.getAllClasses()) {
                try {
                    Class<?> clazz = ci.loadClass();
                    if (!clazz.isPrimitive() && !clazz.isInterface() && !clazz.isAnnotation()) {
                        registry.getOrAnalyze(clazz);
                    }
                } catch (Throwable ignored) {
                    // ignore classes that cannot be loaded
                }
            }
        }
    }
}


package com.yourcompany.sensitive.masking;

import com.yourcompany.sensitive.meta.ClassMetadata;
import com.yourcompany.sensitive.meta.FieldMetadata;
import com.yourcompany.sensitive.meta.MetadataRegistry;

import java.lang.reflect.Array;
import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.util.*;

public class SensitiveMasker {

    private final MaskingStrategy defaultStrategy;
    private final String defaultMask;
    private final String globalRegex;
    private final MetadataRegistry metadataRegistry;

    public SensitiveMasker(MaskingStrategy defaultStrategy,
                           String defaultMask,
                           String globalRegex,
                           MetadataRegistry metadataRegistry) {
        this.defaultStrategy = defaultStrategy;
        this.defaultMask = defaultMask;
        this.globalRegex = globalRegex;
        this.metadataRegistry = metadataRegistry;
    }

    /**
     * Mask an object graph. This method is safe to call from the TurboFilter.
     * It mutates POJOs in place and returns wrappers for records.
     */
    public Object maskObject(Object obj) {
        return maskObject(obj, new IdentityHashMap<>());
    }

    private Object maskObject(Object obj, Map<Object, Boolean> visited) {
        if (obj == null) return null;
        if (isPrimitiveLike(obj)) return obj;
        if (visited.containsKey(obj)) return obj;
        visited.put(obj, Boolean.TRUE);

        Class<?> clazz = obj.getClass();

        // Arrays (handles primitive and object arrays)
        if (clazz.isArray()) {
            int len = Array.getLength(obj);
            for (int i = 0; i < len; i++) {
                Object element = Array.get(obj, i);
                Array.set(obj, i, maskObject(element, visited));
            }
            return obj;
        }

        // Collections (List, Set, Queue, Deque, SequencedCollection)
        if (obj instanceof Collection<?> col) {
            for (Object element : col) maskObject(element, visited);
            return obj;
        }

        // Maps (mask values)
        if (obj instanceof Map<?, ?> map) {
            for (Map.Entry<?, ?> e : map.entrySet()) {
                e.setValue(maskObject(e.getValue(), visited));
            }
            return obj;
        }

        // Optional
        if (obj instanceof Optional<?> opt) {
            opt.ifPresent(v -> maskObject(v, visited));
            return obj;
        }

        // Use metadata for POJO or record
        ClassMetadata meta = metadataRegistry.getOrAnalyze(clazz);
        if (meta.isRecord()) {
            return maskRecord(obj, meta, visited);
        } else {
            return maskPojo(obj, meta, visited);
        }
    }

    private Object maskRecord(Object record, ClassMetadata meta, Map<Object, Boolean> visited) {
        var components = meta.recordComponents();
        var fm = meta.fieldMetadata();
        String[] maskedStrings = new String[components.size()];

        for (int i = 0; i < components.size(); i++) {
            var rc = components.get(i);
            var fmd = fm.get(i);
            try {
                Method accessor = (Method) fmd.accessor();
                Object value = accessor.invoke(record);

                if (fmd.isSensitive()) {
                    maskedStrings[i] = applyMaskForAnyType(fmd, value, visited);
                } else {
                    Object maskedValue = maskObject(value, visited);
                    maskedStrings[i] = String.valueOf(maskedValue);
                }
            } catch (Exception e) {
                maskedStrings[i] = "<error>";
            }
        }

        return new MaskedRecordView(record, components.toArray(new java.lang.reflect.RecordComponent[0]), maskedStrings);
    }

    private Object maskPojo(Object obj, ClassMetadata meta, Map<Object, Boolean> visited) {
        List<Field> fields = meta.fields();
        List<FieldMetadata> fm = meta.fieldMetadata();

        for (int i = 0; i < fields.size(); i++) {
            Field field = fields.get(i);
            FieldMetadata fmd = fm.get(i);
            try {
                Object value = field.get(obj);
                if (fmd.isSensitive()) {
                    // mask any type by converting to masked string and set if field is String,
                    // otherwise attempt to mask nested structure and leave non-String fields unchanged
                    if (value instanceof String s) {
                        field.set(obj, applyMaskForAnyType(fmd, s, visited));
                    } else {
                        // For non-String sensitive fields: try to mask nested structure and set string representation if field is String
                        Object masked = maskObject(value, visited);
                        if (field.getType().equals(String.class)) {
                            field.set(obj, String.valueOf(masked));
                        } else {
                            // cannot set non-string typed field to masked string; leave original value but ensure nested masking
                            // nested masking already applied via maskObject
                        }
                    }
                } else {
                    maskObject(value, visited);
                }
            } catch (Exception ignored) {}
        }
        return obj;
    }

    private String applyMaskForAnyType(FieldMetadata fmd, Object value, Map<Object, Boolean> visited) {
        if (value == null) return "null";

        // Strings
        if (value instanceof String s) {
            String maskPattern = fmd.mask().orElse(defaultMask);
            String fieldRegex = fmd.regex().orElse(null);
            if (fieldRegex != null && !fieldRegex.isEmpty()) {
                return new RegexMaskingStrategy(fieldRegex).mask(s, maskPattern);
            }
            if (globalRegex != null && !globalRegex.isEmpty()) {
                return new RegexMaskingStrategy(globalRegex).mask(s, maskPattern);
            }
            return defaultStrategy.mask(s, maskPattern);
        }

        // Primitive-like
        Class<?> vt = value.getClass();
        if (vt.isPrimitive() || value instanceof Number || value instanceof Boolean || value instanceof Character || vt.isEnum()) {
            String str = String.valueOf(value);
            String maskPattern = fmd.mask().orElse(defaultMask);
            String fieldRegex = fmd.regex().orElse(null);
            if (fieldRegex != null && !fieldRegex.isEmpty()) {
                return new RegexMaskingStrategy(fieldRegex).mask(str, maskPattern);
            }
            if (globalRegex != null && !globalRegex.isEmpty()) {
                return new RegexMaskingStrategy(globalRegex).mask(str, maskPattern);
            }
            return defaultStrategy.mask(str, maskPattern);
        }

        // Complex object: recursively mask and return its string representation
        Object masked = maskObject(value, visited);
        return String.valueOf(masked);
    }

    private boolean isPrimitiveLike(Object obj) {
        Class<?> c = obj.getClass();
        return c.isPrimitive()
                || obj instanceof String
                || obj instanceof Number
                || obj instanceof Boolean
                || obj instanceof Character
                || c.isEnum();
    }
}


package com.yourcompany.sensitive.masking;

import java.lang.reflect.RecordComponent;
import java.util.Objects;

public final class MaskedRecordView {

    private final Object originalRecord;
    private final Class<?> recordClass;
    private final RecordComponent[] components;
    private final String[] maskedComponentStrings;

    public MaskedRecordView(Object originalRecord,
                            RecordComponent[] components,
                            String[] maskedComponentStrings) {
        this.originalRecord = Objects.requireNonNull(originalRecord);
        this.recordClass = originalRecord.getClass();
        this.components = components.clone();
        this.maskedComponentStrings = maskedComponentStrings.clone();
    }

    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder();
        sb.append(recordClass.getSimpleName()).append("[");
        for (int i = 0; i < components.length; i++) {
            if (i > 0) sb.append(", ");
            sb.append(components[i].getName()).append("=");
            sb.append(maskedComponentStrings[i]);
        }
        sb.append("]");
        return sb.toString();
    }

    public Object original() { return originalRecord; }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof MaskedRecordView)) return false;
        MaskedRecordView that = (MaskedRecordView) o;
        return originalRecord.equals(that.originalRecord);
    }

    @Override
    public int hashCode() {
        return originalRecord.hashCode();
    }
}
