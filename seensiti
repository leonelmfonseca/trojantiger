import org.slf4j.Marker;

import ch.qos.logback.classic.Level;
import ch.qos.logback.classic.Logger;
import ch.qos.logback.classic.turbo.TurboFilter;
import ch.qos.logback.core.spi.FilterReply;

public class MaskingTurboFilter extends TurboFilter {

    private final MaskingService maskingService;

    public MaskingTurboFilter(MaskingService maskingService) {
        this.maskingService = maskingService;
        setName(MaskingTurboFilter.class.getSimpleName());
    }

    @Override
    public FilterReply decide(Marker marker, Logger logger, Level level, String format, Object[] params, Throwable t) {
        if (!isStarted() || params == null) {
            return FilterReply.NEUTRAL;
        }

        for (int i = 0; i < params.length; i++) {
            if (params[i] != null && maskingService.hasMaskedFields(params[i].getClass())) {
                params[i] = new LazyMaskedWrapper(params[i], maskingService);
            }
        }

        return FilterReply.NEUTRAL;
    }
}
