package com.yourcompany.sensitive.masking;

import com.yourcompany.sensitive.meta.ClassMetadata;
import com.yourcompany.sensitive.meta.FieldMetadata;
import com.yourcompany.sensitive.meta.MetadataRegistry;

import java.lang.reflect.Array;
import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.lang.reflect.RecordComponent;
import java.util.*;
import java.util.stream.Collectors;

public class SensitiveMasker {

    private final MaskingStrategy defaultStrategy;
    private final String defaultMask;
    private final String globalRegex;
    private final MetadataRegistry metadataRegistry;

    public SensitiveMasker(MaskingStrategy defaultStrategy,
                           String defaultMask,
                           String globalRegex,
                           MetadataRegistry metadataRegistry) {
        this.defaultStrategy = defaultStrategy;
        this.defaultMask = defaultMask;
        this.globalRegex = globalRegex;
        this.metadataRegistry = metadataRegistry;
    }

    /**
     * Returns a masked view or masked string for the given object.
     * Does NOT mutate the original object.
     */
    public Object maskObject(Object obj) {
        return maskObject(obj, new IdentityHashMap<>());
    }

    private Object maskObject(Object obj, Map<Object, Boolean> visited) {
        if (obj == null) return null;
        if (isPrimitiveLike(obj)) {
            // primitives and wrappers -> return masked string
            return applyMaskForPrimitiveLike(null, obj);
        }
        if (visited.containsKey(obj)) {
            // cycle detected: return a simple placeholder to avoid infinite recursion
            return "<cyclic>";
        }
        visited.put(obj, Boolean.TRUE);

        Class<?> clazz = obj.getClass();

        // Arrays
        if (clazz.isArray()) {
            int len = Array.getLength(obj);
            String[] masked = new String[len];
            for (int i = 0; i < len; i++) {
                Object element = Array.get(obj, i);
                Object maskedElement = maskObject(element, visited);
                masked[i] = String.valueOf(maskedElement);
            }
            return new MaskedArrayView(obj, masked);
        }

        // Optional
        if (obj instanceof Optional<?> opt) {
            if (opt.isEmpty()) return Optional.empty();
            Object inner = opt.get();
            Object maskedInner = maskObject(inner, visited);
            return Optional.ofNullable(maskedInner);
        }

        // Collections
        if (obj instanceof Collection<?> col) {
            List<String> masked = new ArrayList<>(col.size());
            for (Object e : col) {
                Object me = maskObject(e, visited);
                masked.add(String.valueOf(me));
            }
            return new MaskedCollectionView(col, masked);
        }

        // Maps
        if (obj instanceof Map<?, ?> map) {
            LinkedHashMap<String, String> masked = new LinkedHashMap<>();
            for (Map.Entry<?, ?> e : map.entrySet()) {
                String keyStr = String.valueOf(e.getKey());
                Object mv = maskObject(e.getValue(), visited);
                masked.put(keyStr, String.valueOf(mv));
            }
            return new MaskedMapView(map, masked);
        }

        // Use metadata for POJO or record
        ClassMetadata meta = metadataRegistry.getOrAnalyze(clazz);
        if (meta.isRecord()) {
            return maskRecordAsView(obj, meta, visited);
        } else {
            return maskPojoAsView(obj, meta, visited);
        }
    }

    private Object maskRecordAsView(Object record, ClassMetadata meta, Map<Object, Boolean> visited) {
        List<RecordComponent> components = meta.recordComponents();
        List<FieldMetadata> fm = meta.fieldMetadata();
        String[] maskedStrings = new String[components.size()];

        for (int i = 0; i < components.size(); i++) {
            RecordComponent rc = components.get(i);
            FieldMetadata fmd = fm.get(i);
            try {
                Method accessor = (Method) fmd.accessor();
                Object value = accessor.invoke(record);
                if (fmd.isSensitive()) {
                    maskedStrings[i] = applyMaskForAnyType(fmd, value, visited);
                } else {
                    Object masked = maskObject(value, visited);
                    maskedStrings[i] = String.valueOf(masked);
                }
            } catch (Exception e) {
                maskedStrings[i] = "<error>";
            }
        }

        return new MaskedRecordView(record, components.toArray(new RecordComponent[0]), maskedStrings);
    }

    private Object maskPojoAsView(Object obj, ClassMetadata meta, Map<Object, Boolean> visited) {
        List<Field> fields = meta.fields();
        List<FieldMetadata> fm = meta.fieldMetadata();

        List<String> names = new ArrayList<>(fields.size());
        List<String> masked = new ArrayList<>(fields.size());
        boolean anySensitiveNonString = false;

        for (int i = 0; i < fields.size(); i++) {
            Field field = fields.get(i);
            FieldMetadata fmd = fm.get(i);
            names.add(field.getName());
            try {
                Object value = field.get(obj);
                if (fmd.isSensitive()) {
                    // If field is String typed, we can mask and show masked string
                    if (field.getType().equals(String.class)) {
                        String maskedStr = applyMaskForAnyType(fmd, value, visited);
                        masked.add(maskedStr);
                    } else {
                        // For primitives, wrappers, enums, or complex types: produce masked string representation
                        String maskedStr = applyMaskForAnyType(fmd, value, visited);
                        masked.add(maskedStr);
                        anySensitiveNonString = true;
                    }
                } else {
                    Object maskedVal = maskObject(value, visited);
                    masked.add(String.valueOf(maskedVal));
                }
            } catch (Exception e) {
                masked.add("<error>");
            }
        }

        // If there are no sensitive fields at all, return original object (no wrapper)
        boolean hasAnySensitive = fm.stream().anyMatch(FieldMetadata::isSensitive);
        if (!hasAnySensitive) {
            return obj;
        }

        // Always return a MaskedPojoView so logging shows masked representation and original is untouched
        return new MaskedPojoView(obj, names, masked);
    }

    /**
     * Produce a masked string for any type (String, primitive-like, or complex).
     * For complex objects this will recursively mask nested sensitive fields and return the stringified masked view.
     */
    private String applyMaskForAnyType(FieldMetadata fmd, Object value, Map<Object, Boolean> visited) {
        if (value == null) return "null";

        // Strings
        if (value instanceof String s) {
            String maskPattern = (fmd != null && fmd.mask().isPresent()) ? fmd.mask().get() : defaultMask;
            String fieldRegex = (fmd != null && fmd.regex().isPresent()) ? fmd.regex().get() : null;
            if (fieldRegex != null && !fieldRegex.isEmpty()) {
                return new RegexMaskingStrategy(fieldRegex).mask(s, maskPattern);
            }
            if (globalRegex != null && !globalRegex.isEmpty()) {
                return new RegexMaskingStrategy(globalRegex).mask(s, maskPattern);
            }
            return defaultStrategy.mask(s, maskPattern);
        }

        // Primitive-like (wrappers, enums)
        Class<?> vt = value.getClass();
        if (vt.isPrimitive() || value instanceof Number || value instanceof Boolean || value instanceof Character || vt.isEnum()) {
            String str = String.valueOf(value);
            String maskPattern = (fmd != null && fmd.mask().isPresent()) ? fmd.mask().get() : defaultMask;
            String fieldRegex = (fmd != null && fmd.regex().isPresent()) ? fmd.regex().get() : null;
            if (fieldRegex != null && !fieldRegex.isEmpty()) {
                return new RegexMaskingStrategy(fieldRegex).mask(str, maskPattern);
            }
            if (globalRegex != null && !globalRegex.isEmpty()) {
                return new RegexMaskingStrategy(globalRegex).mask(str, maskPattern);
            }
            return defaultStrategy.mask(str, maskPattern);
        }

        // Complex object: recursively mask and return its string representation
        Object masked = maskObject(value, visited);
        return String.valueOf(masked);
    }

    /**
     * Helper used when we detect primitive-like at top-level without FieldMetadata.
     * fmd may be null when called from top-level maskObject for primitive wrappers.
     */
    private String applyMaskForPrimitiveLike(FieldMetadata fmd, Object value) {
        if (value == null) return "null";
        String str = String.valueOf(value);
        String maskPattern = (fmd != null && fmd.mask().isPresent()) ? fmd.mask().get() : defaultMask;
        String fieldRegex = (fmd != null && fmd.regex().isPresent()) ? fmd.regex().get() : null;
        if (fieldRegex != null && !fieldRegex.isEmpty()) {
            return new RegexMaskingStrategy(fieldRegex).mask(str, maskPattern);
        }
        if (globalRegex != null && !globalRegex.isEmpty()) {
            return new RegexMaskingStrategy(globalRegex).mask(str, maskPattern);
        }
        return defaultStrategy.mask(str, maskPattern);
    }

    private boolean isPrimitiveLike(Object obj) {
        Class<?> c = obj.getClass();
        return c.isPrimitive()
                || obj instanceof String
                || obj instanceof Number
                || obj instanceof Boolean
                || obj instanceof Character
                || c.isEnum();
    }
}


