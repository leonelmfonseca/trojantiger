import java.util.ArrayList;
import java.util.List;

import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Lazy;

import ch.qos.logback.classic.Logger;
import ch.qos.logback.classic.LoggerContext;
import ch.qos.logback.classic.spi.ILoggingEvent;
import ch.qos.logback.core.Appender;

import jakarta.annotation.PostConstruct;

@Configuration
@EnableConfigurationProperties(MaskingProperties.class)
public class MaskingAutoConfiguration {

    @Lazy
    @Autowired
    private MaskingService maskingService;

    @Bean
    MaskingService maskingService(MaskingProperties properties) {
        MaskingService service = new MaskingService(properties);
        service.init();
        return service;
    }

    @PostConstruct
    void registerMaskingAppender() {
        LoggerContext lc = (LoggerContext) LoggerFactory.getILoggerFactory();
        Logger root = lc.getLogger(Logger.ROOT_LOGGER_NAME);

        List<Appender<ILoggingEvent>> existing = new ArrayList<>();
        java.util.Iterator<Appender<ILoggingEvent>> iter = root.iteratorForAppenders();
        while (iter.hasNext()) {
            existing.add(iter.next());
        }
        for (Appender<ILoggingEvent> appender : existing) {
            MaskingAppender maskingAppender = new MaskingAppender(maskingService, appender);
            maskingAppender.setContext(lc);
            maskingAppender.start();
            root.detachAppender(appender);
            root.addAppender(maskingAppender);
        }
    }
}

