public ListCheckResult evaluate(AccountLookupRequest request) {
    var matches = repo.findAll(
        AccessControlListSpecs.matches(
            request.getCode(),
            request.getCodeDetailed(),
            request.getWay()
        )
    );

    if (matches.isEmpty()) {
        return ListCheckResult.NOT_IN_LIST;
    }

    if (matches.stream().anyMatch(this::hasEmptyRule)) {
        log.warn("Account [{}] matched a rule with no criteria → EMPTY_RULE", request.getAccId());
        return ListCheckResult.EMPTY_RULE;
    }

    var result = matches.stream()
        .anyMatch(r -> r.getStatus() == RuleStatus.OK)
        ? ListCheckResult.WHITELISTED
        : ListCheckResult.BLACKLISTED;

    log.info(buildLogMessage(matches.get(0), result, request.getAccId()));
    return result;
}

private boolean hasEmptyRule(BlackWhiteList rule) {
    var id = rule.getId();
    return !hasValue(id.getCode() != null ? id.getCode().toString() : null)
        && !hasValue(id.getCodeDetailed())
        && !hasValue(id.getWay());
}
