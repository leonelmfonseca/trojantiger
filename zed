public static Specification<BlackWhiteList> matches(String code, String codeDetailed, String way) {
    
    Specification<BlackWhiteList> ordering = 
        (Root<BlackWhiteList> root, CriteriaQuery<?> query, CriteriaBuilder cb) -> {
            query.orderBy(
                cb.asc(cb.selectCase()
                    .when(cb.isNull(root.get("id").get("code")), 0)
                    .otherwise(1)),
                cb.asc(cb.selectCase()
                    .when(cb.isNull(root.get("id").get("way")), 0)
                    .otherwise(1)),
                cb.asc(cb.selectCase()
                    .when(cb.isNull(root.get("id").get("codeDetailed")), 0)
                    .otherwise(1))
            );
            return cb.conjunction(); // always true — just here for ordering
        };

    return ordering
        .and(fieldMatches("code", code))
        .and(fieldMatches("codeDetailed", codeDetailed))
        .and(fieldMatches("way", way));
}
