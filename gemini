Masking strategies
java
public interface MaskingStrategy {
    String mask(String value, String maskPattern);
}

public class FullMaskingStrategy implements MaskingStrategy {
    @Override
    public String mask(String value, String maskPattern) {
        return maskPattern;
    }
}

import java.util.regex.Pattern;
public class RegexMaskingStrategy implements MaskingStrategy {
    private final Pattern pattern;
    public RegexMaskingStrategy(String regex) { this.pattern = Pattern.compile(regex); }
    @Override
    public String mask(String value, String replacement) {
        if (value == null) return null;
        return pattern.matcher(value).replaceAll(replacement);
    }
}
Universal masking engine
Capabilities

Detects and reconstructs records with masked components

Mutates POJOs in place for masked fields

Traverses arrays, Collections, Maps, Optionals

Handles unmodifiable collections by masking referenced objects (not replacing immutable containers)

Avoids infinite recursion using an IdentityHashMap visited set

Applies field-level regex or global regex or default mask

Core class

java
import java.lang.reflect.*;
import java.util.*;

public class SensitiveMasker {

    private final MaskingStrategy defaultStrategy;
    private final String defaultMask;
    private final String globalRegex;

    public SensitiveMasker(MaskingStrategy defaultStrategy,
                           String defaultMask,
                           String globalRegex) {
        this.defaultStrategy = defaultStrategy;
        this.defaultMask = defaultMask;
        this.globalRegex = globalRegex;
    }

    public Object maskObject(Object obj) {
        return maskObject(obj, new IdentityHashMap<>());
    }

    private Object maskObject(Object obj, Map<Object, Boolean> visited) {
        if (obj == null) return null;
        if (isPrimitiveLike(obj)) return obj;
        if (visited.containsKey(obj)) return obj;
        visited.put(obj, Boolean.TRUE);

        Class<?> clazz = obj.getClass();

        // Records
        if (clazz.isRecord()) {
            return maskRecord(obj, visited);
        }

        // Arrays
        if (clazz.isArray()) {
            int len = Array.getLength(obj);
            for (int i = 0; i < len; i++) {
                Object element = Array.get(obj, i);
                Array.set(obj, i, maskObject(element, visited));
            }
            return obj;
        }

        // Collections
        if (obj instanceof Collection<?> col) {
            for (Object element : col) maskObject(element, visited);
            return obj;
        }

        // Maps
        if (obj instanceof Map<?, ?> map) {
            for (Map.Entry<?, ?> e : map.entrySet()) maskObject(e.getValue(), visited);
            return obj;
        }

        // Optional
        if (obj instanceof Optional<?> opt) {
            opt.ifPresent(v -> maskObject(v, visited));
            return obj;
        }

        // POJO
        return maskPojo(obj, visited);
    }

    private Object maskRecord(Object record, Map<Object, Boolean> visited) {
        Class<?> clazz = record.getClass();
        RecordComponent[] components = clazz.getRecordComponents();
        Object[] args = new Object[components.length];

        for (int i = 0; i < components.length; i++) {
            RecordComponent rc = components[i];
            try {
                Object value = rc.getAccessor().invoke(record);
                Sensitive sensitive = rc.getAccessor().getAnnotation(Sensitive.class);
                if (sensitive != null && value instanceof String s) {
                    args[i] = applyMask(sensitive, s);
                } else {
                    args[i] = maskObject(value, visited);
                }
            } catch (Exception e) {
                args[i] = null;
            }
        }

        try {
            Constructor<?> ctor = clazz.getDeclaredConstructor(
                Arrays.stream(components).map(RecordComponent::getType).toArray(Class[]::new)
            );
            ctor.setAccessible(true);
            return ctor.newInstance(args);
        } catch (Exception e) {
            return record;
        }
    }

    private Object maskPojo(Object obj, Map<Object, Boolean> visited) {
        for (Field field : getAllFields(obj.getClass())) {
            field.setAccessible(true);
            try {
                Object value = field.get(obj);
                Sensitive sensitive = field.getAnnotation(Sensitive.class);
                if (sensitive != null && value instanceof String s) {
                    field.set(obj, applyMask(sensitive, s));
                } else {
                    maskObject(value, visited);
                }
            } catch (Exception ignored) {}
        }
        return obj;
    }

    private String applyMask(Sensitive sensitive, String value) {
        String maskPattern = (sensitive.mask() == null || sensitive.mask().isEmpty()) ? defaultMask : sensitive.mask();
        String regex = (sensitive.regex() == null || sensitive.regex().isEmpty()) ? globalRegex : sensitive.regex();
        if (regex != null && !regex.isEmpty()) {
            return new RegexMaskingStrategy(regex).mask(value, maskPattern);
        }
        return defaultStrategy.mask(value, maskPattern);
    }

    private boolean isPrimitiveLike(Object obj) {
        Class<?> c = obj.getClass();
        return c.isPrimitive() || obj instanceof String || obj instanceof Number
               || obj instanceof Boolean || obj instanceof Character || c.isEnum();
    }

    private List<Field> getAllFields(Class<?> type) {
        List<Field> fields = new ArrayList<>();
        Class<?> current = type;
        while (current != null && current != Object.class) {
            fields.addAll(Arrays.asList(current.getDeclaredFields()));
            current = current.getSuperclass();
        }
        return fields;
    }
}
Logback TurboFilter with level filtering
java
import ch.qos.logback.classic.Level;
import ch.qos.logback.classic.Logger;
import ch.qos.logback.classic.turbo.TurboFilter;
import ch.qos.logback.core.spi.FilterReply;
import org.slf4j.Marker;

import java.util.Set;

public class SensitiveTurboFilter extends TurboFilter {

    private final SensitiveMasker masker;
    private final Set<Level> levels;

    public SensitiveTurboFilter(SensitiveMasker masker, Set<Level> levels) {
        this.masker = masker;
        this.levels = levels;
    }

    @Override
    public FilterReply decide(Marker marker,
                              Logger logger,
                              Level level,
                              String format,
                              Object[] params,
                              Throwable t) {

        if (!levels.contains(level)) return FilterReply.NEUTRAL;
        if (params != null) {
            for (int i = 0; i < params.length; i++) {
                params[i] = masker.maskObject(params[i]);
            }
        }
        return FilterReply.NEUTRAL;
    }
}
Manual registration without a starter
Call this early in your application startup (for example in main):

java
import ch.qos.logback.classic.LoggerContext;
import ch.qos.logback.classic.Level;
import org.slf4j.LoggerFactory;
import java.util.Set;

public class SensitiveLoggingBootstrap {
    public static void init() {
        LoggerContext context = (LoggerContext) LoggerFactory.getILoggerFactory();

        MaskingStrategy defaultStrategy = new FullMaskingStrategy();
        String defaultMask = "****";
        String globalRegex = "\\d(?=\\d{4})"; // example: mask all but last 4 digits

        SensitiveMasker masker = new SensitiveMasker(defaultStrategy, defaultMask, globalRegex);
        Set<Level> levels = Set.of(Level.INFO, Level.DEBUG);

        SensitiveTurboFilter filter = new SensitiveTurboFilter(masker, levels);
        filter.start();
        context.addTurboFilter(filter);
    }
}
Call SensitiveLoggingBootstrap.init() before your application begins logging.

